{
  "identity": {
    "family": "INFINITY HYPER",
    "version": "5.5"
  },
  "name": "hyper-5.5-small",
  "model": {
    "vocab_size": 16384,
    "context_length": 1024,
    "d_model": 768,
    "n_layers": 12,
    "n_heads": 12,
    "d_ff": 2048,
    "dropout": 0.0,
    "rope_theta": 10000.0,
    "norm_eps": 1e-05,
    "tie_embeddings": true
  },
  "train": {
    "batch_size": 16,
    "grad_accum_steps": 8,
    "max_steps": 20000,
    "learning_rate": 0.0006,
    "min_lr_ratio": 0.1,
    "warmup_steps": 1000,
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "grad_clip": 1.0,
    "eval_interval": 500,
    "eval_batches": 50,
    "checkpoint_interval": 1000,
    "seed": 1337,
    "precision": "bf16",
    "device": "auto",
    "num_threads": 0,
    "strategy": "single",
    "time_budget_hours": 11.0
  },
  "data_manifest": "data/manifest.json",
  "tokenizer_vocab_size": 16384,
  "output_dir": "runs/hyper-5.5-small"
}
